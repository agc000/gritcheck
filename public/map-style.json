{
  "version": 8,
  "name": "GritCheck Dark Gold",
  "metadata": {
    "gritcheck:note": "Hand-authored dark-gold style (BUILD_PLAN §2.1/§4.2). Base map fabric only: background, greens, water, roads, paths, flat building context, muted labels. Gold is reserved as a SIGNAL for the campus hero-building layer (added later in Phase 3) and never appears in this base fabric. Palette tracks the §4.1 tokens."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\" rel=\"noopener\">OpenFreeMap</a> © <a href=\"https://www.openmaptiles.org/\" target=\"_blank\" rel=\"noopener\">OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a>"
    },
    "campus-labels": {
      "type": "geojson",
      "data": "/campus-labels.geojson"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#191813"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#202b16",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#243218",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse-university",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "==",
        "class",
        "university"
      ],
      "paint": {
        "fill-color": "#231f17"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#13242f"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#16232c",
        "line-width": 1
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "trunk",
        "primary",
        "secondary",
        "tertiary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#161409",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          3,
          17,
          11
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "trunk",
        "primary",
        "secondary",
        "tertiary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#4a4534",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          1.5,
          17,
          7
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#38342a",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          1,
          17,
          4
        ]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "path",
        "pedestrian",
        "track"
      ],
      "paint": {
        "line-color": "#6E8B99",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          1.1,
          18,
          3
        ],
        "line-dasharray": [
          2,
          2
        ],
        "line-opacity": 0.72
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#332f25",
        "fill-outline-color": "#403b30",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "campus-building-label",
      "type": "symbol",
      "source": "campus-labels",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 9.5,
        "text-max-width": 7,
        "text-padding": 3
      },
      "paint": {
        "text-color": "#8A8578",
        "text-halo-color": "#121110",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": [
        "in",
        "class",
        "primary",
        "secondary",
        "tertiary"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#6e6a60",
        "text-halo-color": "#121110",
        "text-halo-width": 1
      }
    },
    {
      "id": "park-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "park",
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#5f6a48",
        "text-halo-color": "#121110",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        "class",
        "suburb",
        "neighbourhood",
        "quarter"
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#8f8b80",
        "text-halo-color": "#121110",
        "text-halo-width": 1.2
      }
    }
  ]
}