{
  "name": "gritcheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scraper/seed/validate.ts && node --test \"scraper/test/*.test.ts\"",
    "scrape": "node scraper/src/run.ts",
    "test:decay": "npx supabase test db",
    "test:limits": "node scripts/test-submit-update.mjs",
    "seed": "node --env-file=.env.local scraper/seed/load.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "@vercel/analytics": "^2.0.1",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.4.3"
  }
}
